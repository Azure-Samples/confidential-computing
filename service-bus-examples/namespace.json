{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namespaceName": { "type": "string" },
    "location": { "type": "string" },
    "queueName": { "type": "string" },
    "principalId": { "type": "string" },
    "principalType": {
      "type": "string",
      "defaultValue": "User",
      "allowedValues": ["User", "ServicePrincipal"]
    }
  },
  "variables": {
    "namespaceId": "[resourceId('Microsoft.ServiceBus/namespaces', parameters('namespaceName'))]",
    "senderRole": "69a216fc-b8fb-44d8-bc22-1f3c2cd27a39",
    "receiverRole": "4f6d3b9b-027b-4f4c-9142-0e5a2a2247e0"
  },
  "resources": [
    {
      "type": "Microsoft.ServiceBus/namespaces",
      "apiVersion": "2025-05-01-preview",
      "name": "[parameters('namespaceName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Premium", "tier": "Premium", "capacity": 1 },
      "properties": {
        "minimumTlsVersion": "1.2",
        "disableLocalAuth": true,
        "publicNetworkAccess": "Enabled",
        "premiumMessagingPartitions": 1,
        "platformCapabilities": {
          "confidentialCompute": { "mode": "Enabled" }
        }
      },
      "tags": { "sample": "confidential-service-bus" }
    },
    {
      "type": "Microsoft.ServiceBus/namespaces/queues",
      "apiVersion": "2025-05-01-preview",
      "name": "[format('{0}/{1}', parameters('namespaceName'), parameters('queueName'))]",
      "dependsOn": ["[variables('namespaceId')]"],
      "properties": {
        "lockDuration": "PT1M",
        "defaultMessageTimeToLive": "PT1H",
        "maxDeliveryCount": 10
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(variables('namespaceId'), parameters('principalId'), variables('senderRole'))]",
      "scope": "[format('Microsoft.ServiceBus/namespaces/{0}', parameters('namespaceName'))]",
      "dependsOn": ["[variables('namespaceId')]"],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('senderRole'))]",
        "principalId": "[parameters('principalId')]",
        "principalType": "[parameters('principalType')]"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(variables('namespaceId'), parameters('principalId'), variables('receiverRole'))]",
      "scope": "[format('Microsoft.ServiceBus/namespaces/{0}', parameters('namespaceName'))]",
      "dependsOn": ["[variables('namespaceId')]"],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('receiverRole'))]",
        "principalId": "[parameters('principalId')]",
        "principalType": "[parameters('principalType')]"
      }
    }
  ],
  "outputs": {
    "namespaceId": { "type": "string", "value": "[variables('namespaceId')]" },
    "fullyQualifiedNamespace": {
      "type": "string",
      "value": "[format('{0}.servicebus.windows.net', parameters('namespaceName'))]"
    }
  }
}
